rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users from publicknowledge.co can read/write
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTeamMember() {
      return isAuthenticated() &&
        request.auth.token.email.matches('.*@publicknowledge[.]co$');
    }

    function isLeaveAdmin() {
      return isTeamMember() && request.auth.token.email in ['charu@publicknowledge.co', 'gyan@publicknowledge.co'];
    }
    function eligibleLeave(email) {
      return email in ['sharang@publicknowledge.co', 'mohit@publicknowledge.co', 'rakesh@publicknowledge.co'];
    }

    function isClientUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/clientUsers/$(request.auth.token.email));
    }

    function clientIdForUser() {
      return get(/databases/$(database)/documents/clientUsers/$(request.auth.token.email)).data.clientId;
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isTeamMember();
      allow read: if isClientUser() && resource.data.clientId == clientIdForUser();
      allow create: if isTeamMember();
      allow create: if isClientUser() && request.resource.data.clientId == clientIdForUser();
      allow update: if isTeamMember();
      allow update: if isClientUser() && resource.data.clientId == clientIdForUser()
                       && request.resource.data.clientId == clientIdForUser();
      allow delete: if isTeamMember();
    }

    // Standups collection
    match /standups/{standupId} {
      allow read: if isTeamMember();
      allow create: if isTeamMember();
      allow update: if isTeamMember() &&
        resource.data.userEmail == request.auth.token.email;
    }

    // Sprints collection
    match /sprints/{sprintId} {
      allow read: if isTeamMember();
      allow write: if isTeamMember();
    }

    // Clients collection
    match /clients/{clientId} {
      allow read: if isTeamMember();
      allow read: if isClientUser() && clientId == clientIdForUser();
      allow write: if isTeamMember();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isTeamMember();
      allow read: if isClientUser() && resource.data.clientId == clientIdForUser();
      allow write: if isTeamMember();
    }

    // People collection
    match /people/{personId} {
      allow read: if isTeamMember();
      allow write: if isTeamMember();
    }

    // Notes collection (for Granola notes etc)
    match /notes/{noteId} {
      allow read: if isTeamMember();
      allow write: if isTeamMember();
    }

    // References collection (design references from Slack)
    match /references/{referenceId} {
      allow read: if isTeamMember();
      allow write: if isTeamMember();
    }

    // Moodboards collection (curated reference groups)
    match /moodboards/{moodboardId} {
      allow read: if isTeamMember();
      allow write: if isTeamMember();
    }

    // Daily focus (per-user daily task curation).
    // Any team member can schedule tasks on any teammate's day — the whole
    // studio workflow depends on gyan being able to plan charu's week, etc.
    match /dailyFocus/{docId} {
      allow read: if isTeamMember() || isClientUser();
      allow create: if isTeamMember();
      allow update: if isTeamMember();
    }

    // User profiles (photos, display names)
    match /users/{email} {
      allow read: if isTeamMember();
      allow write: if isTeamMember() &&
        request.auth.token.email == email;
    }

    // Client users (allowlist for external client login)
    match /clientUsers/{email} {
      allow read, write: if isTeamMember();
      allow read: if isClientUser() && email == request.auth.token.email;
    }

    // Processes collection (studio SOPs / runbooks)
    match /processes/{processId} {
      allow read: if isTeamMember();
      allow write: if isTeamMember();
    }

    // Leave closes are written only through the authenticated backend.
    match /leaveCloses/{closeId} {
      allow read: if isLeaveAdmin();
      allow write: if false;
    }
    match /leaves/{leaveId} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && eligibleLeave(request.resource.data.userEmail)
        && (isLeaveAdmin() || request.resource.data.userEmail == request.auth.token.email)
        && (!(request.resource.data.get('creditApproved', false)) || isLeaveAdmin());
      allow update: if isTeamMember() && eligibleLeave(resource.data.userEmail)
        && request.resource.data.userEmail == resource.data.userEmail
        && (isLeaveAdmin() || resource.data.userEmail == request.auth.token.email)
        && (isLeaveAdmin() || request.resource.data.get('creditApproved', false) == resource.data.get('creditApproved', false));
      allow delete: if isLeaveAdmin();
    }
    match /holidays/{holidayId} {
      allow read: if isTeamMember();
      allow write: if isLeaveAdmin();
    }
    match /contracts/{contractId} {
      allow read: if isTeamMember();
      allow write: if isLeaveAdmin();
    }
  }
}
